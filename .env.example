# AI Flow's secrets and overrides. Copy to .env and fill in: cp .env.example .env
# .env is ignored by git. Any setting in config.py can be overridden here by name.

# The AI Flow bot's token, from @BotFather.
TELEGRAM_BOT_TOKEN=
# Where to post. The bot must be an admin of the channel.
CHANNEL_ID=@ai_flow_daily
# Your own Telegram id, for error alerts.
ERROR_CHAT_ID=
# Pays for every model call, embeddings included.
OPENROUTER_API_KEY=
# Added under every post.
SIGNATURE_HTML='<a href="https://t.me/ai_flow_daily">AI Flow | Subscribe</a>'

# The dashboard API's token. The same value must be set as DASHBOARD_TOKEN in the
# Vercel project. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Common overrides (defaults are in config.py)
#MAX_POSTS_PER_HOUR=12
#MAX_POSTS_PER_DAY=60
#SORTER_MODEL=google/gemini-2.5-flash
#WRITER_MODEL=deepseek/deepseek-v3.2
#LOG_LEVEL=INFO
